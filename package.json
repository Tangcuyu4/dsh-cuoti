{
  "name": "dsh-cuoti",
  "version": "0.1.0",
  "description": "错题本：踩过的坑、犯过的错、根因、解法与预防守则，钉进系统提示词——同样的错不许犯第二遍。工具 cuoti_add 记错题 / cuoti_list 查错题 / cuoti_fix 改账 / cuoti_forget 删账，外加全局「错题本」提示词章节。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "scripts": {
    "harness:check": "node --check lib/index.js"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "lesson",
    "mistake",
    "learning",
    "prompt"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "id": "dsh-cuoti",
    "name": "错题本",
    "version": "0.1.0",
    "permissions": "工具注册、系统提示词注入、读写 ~/.dsh/storages/dsh-cuoti",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
